{% extends "base.html.j2" %}
{% block content %}
<section class="hero{% if d.stale %} hero-stale{% endif %}" {% if site.brand.hero_image %}style="background-image:url('{{ rel }}{{ site.brand.hero_image }}')"{% endif %}>
  <div class="hero-inner">
    <p class="kicker"><span class="en">Weeks 3 &amp; 4 outlook · Sea of Japan side of Hokkaido</span><span class="ja">3〜4週目の見通し・道央日本海側</span></p>
    <h1 class="headline">{{ d.headline }}</h1>
    <p class="hero-meta">
      <span>Issued {{ d.issued }}</span>
      <span class="nerd-only">· inits ECMWF {{ d.init_dates.ecmwf }}, JMA {{ d.init_dates.jma }}</span>
      <span>· valid {{ d.weeks[0].valid[0] }} → {{ d.weeks[1].valid[1] }}</span>
      {% if d.stale %}<span class="stale-badge">Stale since {{ d.stale_since }}</span>{% endif %}
    </p>
    {% if site.brand.hero_credit %}<p class="hero-credit">{{ site.brand.hero_credit }}</p>{% endif %}
  </div>
</section>

{% if d.stale %}<div class="banner banner-stale" role="status">Upstream data has not arrived since {{ d.stale_since }}. This is the last good outlook; treat it as ageing.</div>{% endif %}
{% if not d.snow_model.skilful %}<div class="banner banner-warn" role="status">The snow mapping is <strong>not yet skilful</strong> in the backtest (RPSS {{ d.snow_model.skill.rpss|num }}, {{ d.snow_model.skill.period }}), so the snow-week calls below are shown greyed out. The circulation indices are the product.</div>{% endif %}

<section class="weeks" aria-labelledby="weeks-h">
  <h2 id="weeks-h"><span class="en">{{ site.wording.signal_name }}</span><span class="ja">先読みシグナル</span></h2>
  <p class="lede normie-only">{{ site.wording.signal_blurb }}</p>
  <div class="cards cards-2">
  {% for w in d.weeks %}
    <article class="card week-card grade-{{ w.grade|lower|replace(' ', '-') }}{% if not d.snow_model.skilful %} card-muted{% endif %}">
      <div class="card-top">
        <span class="card-label">{{ w.label }} · {{ w.valid[0][5:] }} – {{ w.valid[1][5:] }}</span>
        <span class="chip chip-big{% if w.big_week >= 0.3 %} chip-hot{% endif %}" title="Probability of a top-quintile snow week">Big week {{ pct(w.big_week) }}%</span>
      </div>
      <div class="card-body">
        <p class="grade"><span class="grade-dot"></span><strong>{{ w.grade }}</strong>{% if w.grade != "No signal" %} signal{% endif %}</p>
        <p id="t-{{ w.lead }}" class="sr-only">{{ w.label }}: below normal {{ pct(w.terciles.below) }} percent, near normal {{ pct(w.terciles.near) }} percent, above normal {{ pct(w.terciles.above) }} percent.</p>
        {{ tercile_bar(w.terciles, label_id="t-" ~ w.lead) }}
        <div class="tercile-legend"><span>below</span><span>near normal</span><span>above</span></div>
        <p class="plain">{{ w.line }}</p>
        <div class="nerd-only rubric">
          <p class="rubric-head">Outlook breakdown <span class="muted">(what pushes the odds, logistic-model term contributions)</span></p>
          {{ factor_bars(w.factors) }}
          <table class="data-table"><caption class="sr-only">Factor contributions for {{ w.label }}</caption><thead><tr><th>Factor</th><th>Contribution</th></tr></thead><tbody>
            {% for f in w.factors %}<tr><td>{{ f.name }}</td><td>{{ f.contribution|num('+') }}</td></tr>{% endfor %}</tbody></table>
          {% if w.lift %}
          <details class="skill"><summary class="badge{% if not w.lift.significant %} badge-off{% endif %}">{{ w.lift_badge }}</summary>
            <p><strong>Lift first.</strong> The operationally debiased model scores RPSS {{ w.lift.skill_debiased|num }} and the raw model {{ w.lift.skill_raw|num }} against climatology; our calibrated product scores {{ w.lift.skill_pbc|num }}. The badge is the difference to the debiased model with its 95% block-bootstrap interval ({{ w.skill.period }}). Big-week Brier skill {{ w.skill.bss_big|num }}, ROC area {{ w.skill.roc_big|num }}. Small numbers are the honest expectation at weeks 3–4.</p></details>
          {% else %}<p class="badge badge-off">No proven skill yet</p>{% endif %}
        </div>
      </div>
    </article>
  {% endfor %}
  </div>
</section>

<section class="chain" aria-labelledby="chain-h">
  <h2 id="chain-h"><span class="en">The ingredient chain</span><span class="ja">雪のレシピ</span></h2>
  <p class="lede">Five things have to line up for a big week on the Sea of Japan side. Week 3 on the left, week 4 on the right.</p>
  <div class="chain-grid">
  {% for st in d.weeks[0].stages %}
    {% set st4 = d.weeks[1].stages[loop.index0] %}
    <article class="stage stage-{{ st.id }}">
      <div class="stage-head">{{ stage_glyph(st.id) }}<span class="stage-name">{{ loop.index }}. {{ st.name }}</span></div>
      <p class="stage-line">{{ stage_copy(st.id, 'normie') }}</p>
      <div class="stage-states">
        <span class="state state-{{ st.state|replace(' ', '-') }}" title="week 3">wk3: {{ st.state }}</span>
        <span class="state state-{{ st4.state|replace(' ', '-') }}" title="week 4">wk4: {{ st4.state }}</span>
      </div>
      <div class="nerd-only stage-nerd">
        <p class="small">{{ stage_copy(st.id, 'nerd') }}</p>
        {% set idxs = d.indices|selectattr('stage', 'equalto', st.id)|list %}
        {% if idxs %}<p class="small muted">Indices: {% for ix in idxs %}{{ ix.name }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
      </div>
    </article>
  {% endfor %}
  </div>
</section>

<section class="drivers" aria-labelledby="drivers-h">
  <h2 id="drivers-h"><span class="en">What's driving things now</span><span class="ja">現在の背景場</span></h2>
  <div class="strip">
    <div class="strip-item"><span class="strip-k">Arctic Oscillation</span><span class="strip-v">{{ d.drivers.ao.value|num('+', 1) }}</span><span class="strip-s">{% if d.drivers.ao.value <= -1 %}strongly negative: cold air spills south{% elif d.drivers.ao.value >= 1 %}positive: cold air stays polar{% else %}near neutral{% endif %}<span class="nerd-only"> · {{ d.drivers.ao.date }}</span></span></div>
    <div class="strip-item"><span class="strip-k">MJO</span>{{ mjo_wheel(d.drivers.mjo.phase, d.drivers.mjo.amp, d.drivers.mjo.rmm1, d.drivers.mjo.rmm2, 96) }}<span class="strip-s">phase {{ d.drivers.mjo.phase }}, amplitude {{ d.drivers.mjo.amp|num('', 1) }}{% if d.drivers.mjo.amp < 1 %} (weak){% endif %}</span></div>
    <div class="strip-item"><span class="strip-k">Polar vortex</span><span class="strip-v">{{ d.drivers.vortex.state }}</span><span class="strip-s">10 hPa wind at 60°N {{ d.drivers.vortex.u10|num('', 0) }} m/s<span class="nerd-only"> · {{ d.drivers.vortex.date }}</span></span></div>
    <div class="strip-item"><span class="strip-k">Sea of Japan SST</span><span class="strip-v">{{ d.drivers.sst_anom|num('+', 1) }} °C</span><span class="strip-s">{% if d.drivers.sst_anom > 0.3 %}warmer sea: more fuel for sea-effect snow{% elif d.drivers.sst_anom < -0.3 %}cooler sea: a touch less fuel{% else %}near normal{% endif %}</span></div>
    <div class="strip-item"><span class="strip-k">Recent snow vs normal</span>
      {% for name, r in d.drivers.recent_snow.items() %}<span class="strip-s"><span class="ja-inline">{{ r.ja }}</span> {{ name }}: {{ r.obs_cm }} cm vs {{ r.normal_cm }} cm normal{% if r.obs_cm > r.normal_cm * 1.2 %} ↑{% elif r.obs_cm < r.normal_cm * 0.8 %} ↓{% endif %}</span>{% endfor %}</div>
  </div>
</section>

<section class="indices nerd-only" aria-labelledby="idx-h">
  <h2 id="idx-h"><span class="en">Circulation index outlooks</span><span class="ja">循環指数の見通し</span></h2>
  <p class="lede">Each index is forecast as five equally likely bins (quintiles) after calibration; the dashed line is climatology. The badge leads with the <strong>lift</strong> over the operationally debiased model; cards with no demonstrated improvement are greyed out.</p>
  <div class="cards cards-3">
  {% for ix in d.indices %}
    <article class="card idx-card{% if not (ix.skilful['19'] or ix.skilful['26']) %} card-muted{% endif %}">
      <div class="card-top card-top-idx"><span class="card-label">{{ ix.name }}</span>{{ index_glyph(ix.key) }}</div>
      <div class="card-body">
        {% for lead in ['19', '26'] %}
        <div class="idx-lead{% if not ix.skilful[lead] %} idx-off{% endif %}">
          <div class="idx-row"><span class="muted">Week {{ 3 if lead == '19' else 4 }}</span>
            <span class="badge{% if not ix.skilful[lead] %} badge-off{% endif %}" title="{{ ix.lift_badge[lead] }}">{% if ix.skilful[lead] %}lift {{ ix.skill[lead].lift.lift|num('+') }} · RPSS {{ ix.skill[lead].rpss|num }}{% else %}no demonstrated improvement{% endif %}</span></div>
          {{ quintile_bar(ix.quintiles[lead]) }}
          <p class="plain small">{{ ix.line[lead] }}</p>
          <table class="data-table sr-only"><caption>{{ ix.name }} week {{ 3 if lead == '19' else 4 }} quintile probabilities</caption><tbody><tr>{% for p in ix.quintiles[lead] %}<td>{{ pct(p) }}%</td>{% endfor %}</tr></tbody></table>
        </div>
        {% endfor %}
        <details class="explainer"><summary>What is this?</summary><p>{{ index_help(ix.key) }}</p>
          <p class="small muted">Stage {{ ix.stage }} ({{ stage_name(ix.stage) }}). Lift = our calibrated RPSS minus the operationally debiased model's RPSS, 95% block-bootstrap interval; week 3 {{ ix.lift_badge['19'] }}; week 4 {{ ix.lift_badge['26'] }}.</p></details>
      </div>
    </article>
  {% endfor %}
  </div>
</section>

<section class="maps nerd-only" aria-labelledby="maps-h">
  <h2 id="maps-h"><span class="en">Maps</span><span class="ja">地図</span></h2>
  <details class="maps-details"><summary>Show the week-3 maps (most-likely quintile, shaded by confidence)</summary>
    <div class="cards cards-3">
    {% for m in d.maps %}
      <figure class="card map-card"><figcaption class="card-label">{{ m.title }} · week 3</figcaption><img src="{{ rel }}{{ m.file }}" alt="{{ m.title }} week-3 map: most likely quintile per 1.5-degree cell, shaded by confidence" loading="lazy" width="640" height="400"></figure>
    {% endfor %}
    </div>
    <p class="muted small">Dashed boxes are the index regions; the solid box is Hokkaido. 1.5° grid over 21–72°N, 75°E–135°W.</p>
  </details>
</section>

<section class="season nerd-only" aria-labelledby="season-h">
  <h2 id="season-h"><span class="en">Season tracker</span><span class="ja">シーズンの推移</span></h2>
  <p id="season-desc" class="lede">Observed weekly snow (ERA5 snowfall over western Hokkaido, mm water equivalent) against the climatology band, with the tercile called 3 (▲) and 4 (△) weeks earlier for honest verification.</p>
  {{ season_chart(d.season) }}
  <details><summary>Data table</summary><table class="data-table"><thead><tr><th>Week start</th><th>Observed</th><th>Clim 20–80%</th><th>Called at wk3</th><th>Called at wk4</th></tr></thead><tbody>
    {% for w in d.season %}<tr><td>{{ w.start }}</td><td>{{ w.obs }}</td><td>{{ w.clim_lo }}–{{ w.clim_hi }}</td><td>{{ w.fc19 }}</td><td>{{ w.fc26 }}</td></tr>{% endfor %}</tbody></table></details>
</section>

<section class="nerd nerd-only" aria-labelledby="nerd-h">
  <h2 id="nerd-h"><span class="en">Results, methods and limitations</span><span class="ja">結果・手法・限界</span></h2>
  <p class="lede">{{ d.backtest.note }}</p>
  <h3>Lift over the model (headline metric)</h3>
  <table class="data-table"><thead><tr><th>Target</th><th>Model's own skill (debiased, RPSS)</th><th>PBC lift</th><th>95% CI</th><th>Stage-3 lift</th><th>95% CI</th></tr></thead><tbody>
  {% for r in d.backtest.lift %}<tr><td>{{ r.what }}</td><td>{{ r.model_skill|num }}</td><td>{{ r.pbc_lift|num('+') }}</td><td>{{ r.pbc_ci[0]|num('+') }} to {{ r.pbc_ci[1]|num('+') }}</td><td>{{ r.stage3_lift|num('+') }}</td><td>{{ r.stage3_ci[0]|num('+') }} to {{ r.stage3_ci[1]|num('+') }}</td></tr>{% endfor %}</tbody></table>
  <p class="small muted">Three layers, kept apart: what the dynamical model already knew, what PBC adds, what the ingredient model adds. An interval that spans zero is reported as "no demonstrated improvement".</p>
  <h3>Index lift by lead</h3>
  <table class="data-table"><thead><tr><th>Index</th><th>Stage</th><th>Week 3 lift (CI)</th><th>Week 3 RPSS</th><th>Week 4 lift (CI)</th><th>Week 4 RPSS</th></tr></thead><tbody>
  {% for ix in d.indices %}<tr><td>{{ ix.name }}</td><td>{{ ix.stage }}</td><td>{{ ix.skill['19'].lift.lift|num('+') }} ({{ ix.skill['19'].lift.ci[0]|num('+') }}, {{ ix.skill['19'].lift.ci[1]|num('+') }})</td><td>{{ ix.skill['19'].rpss|num }}</td><td>{{ ix.skill['26'].lift.lift|num('+') }} ({{ ix.skill['26'].lift.ci[0]|num('+') }}, {{ ix.skill['26'].lift.ci[1]|num('+') }})</td><td>{{ ix.skill['26'].rpss|num }}</td></tr>{% endfor %}</tbody></table>
  <h3>Windows of opportunity</h3>
  <table class="data-table"><thead><tr><th>Condition at issue time</th><th>n weeks</th><th>Snow-week RPSS</th><th>95% CI</th></tr></thead><tbody>
  {% for r in d.backtest.windows %}<tr><td>{{ r.condition }}</td><td>{{ r.n }}</td><td>{{ r.rpss|num }}</td><td>{{ r.ci[0]|num('+') }} to {{ r.ci[1]|num('+') }}</td></tr>{% endfor %}</tbody></table>
  <h3>Sample size and experiments</h3>
  <p>{{ d.backtest.effective_n.weeks }} DJF weeks in the open test winters, effective sample about {{ d.backtest.effective_n.effective }} after autocorrelation. Experiment log: {{ d.backtest.experiments.n_trials }} configurations evaluated{% if d.backtest.experiments.best is not none %}; best {{ d.backtest.experiments.best|num }}, deflated for selection {{ d.backtest.experiments.deflated|num }}{% endif %}. The last three winters (2023/24–2025/26) are sealed and {% if d.backtest.final_exam %}were evaluated once: {{ d.backtest.final_exam }}{% else %}have not been evaluated yet{% endif %}.</p>
  <h3>Limitations</h3>
  <ul class="small">
    <li>About ten winters of ~13 DJF weeks each, autocorrelated: intervals are wide and a non-significant lift is reported as no signal.</li>
    <li>1.5° fields cannot resolve Hokkaido's terrain or the JPCZ; delivery (stage 5) is explained, not forecast.</li>
    <li>ERA5 snowfall is biased in mountains; SNOW-W is a box average checked against AMeDAS stations, not a resort total.</li>
    <li>JMA changed system several times in the period and its ensembles are small; ECMWF changed cycle in 2023, 2024 and 2026.</li>
  </ul>
  <h3>Reproducibility</h3>
  <p class="small">Commit <code>{{ d.repro.commit }}</code>, state version <code>{{ d.repro.state_version }}</code>. One command: <code>{{ d.repro.command }}</code>. Methods in full: <a href="{{ rel }}method.html">method page</a> and <code>docs/METHOD.md</code>, <code>docs/BACKTEST.md</code>.</p>
  <h3>References</h3>
  {% if d.references %}<ol class="small refs">{% for r in d.references %}<li id="ref-{{ r.key }}">{{ r.text }}{% if r.doi %} <a href="https://doi.org/{{ r.doi }}">doi:{{ r.doi }}</a>{% endif %}</li>{% endfor %}</ol>
  {% else %}<p class="small muted">The reference list is built from <code>references.bib</code> once every entry has passed the checks in <code>docs/REFERENCES_CHECK.md</code>; unverified references never appear here.</p>{% endif %}
</section>
{% endblock %}
